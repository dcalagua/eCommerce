# eCommerce by EBIM — variables de entorno
# Copiar a .env (git-ignored). NUNCA poner aqui claves de servicio.
#
# Solo claves PUBLICABLES en el frontend. El `service_role` vive exclusivamente
# en Edge Functions / servidor (contrato EBIM, seguridad bloqueante).

# Proyecto Supabase propio de eCommerce
VITE_SUPABASE_URL=https://TU-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Hub EBIM (identidad, sociedades, addons) — solo URLs publicas
VITE_EBIM_HUB_URL=https://TU-HUB-REF.supabase.co
VITE_EBIM_APP_SLUG=ecommerce

# Nombre de producto para el lockup "<Producto> by EBIM"
VITE_APP_NAME=eCommerce

# --- Edge Functions (Deno). NUNCA en el bundle del front. -------------------
# Se cargan como secretos de la funcion (`supabase secrets set`), no aqui.
# SUPABASE_URL y SUPABASE_ANON_KEY los inyecta la plataforma.
#
# SUPABASE_SERVICE_ROLE_KEY=...   # solo bootstrap-tenant y create-order
# EBIM_PROVISIONING_KEY=...       # >=32 chars, cabecera x-ebim-provisioning-key
# EBIM_ADMIN_ORIGINS=https://ecommerce.ebim.pe
# EBIM_STOREFRONT_ORIGINS=        # vacio = publico (*)
