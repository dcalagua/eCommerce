          "eventId": "00000000-0000-4ccc-8000-00000000e065"
        },
        {
          "eventId": "00000000-0000-4ccc-8000-00000000e066"
        },
        {
          "eventId": "00000000-0000-4ccc-8000-00000000e067"
        }
      ],
      "response": {
        "status": 200,
        "body": {
          "results": [
            {
              "eventId": "00000000-0000-4ccc-8000-00000000e065",
              "status": "ACCEPTED"
            },
